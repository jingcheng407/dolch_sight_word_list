/**
 * iPad专用布局样式
 * 针对iPad的单屏显示和触摸操作优化
 */

/* ===== iPad设备检测 ===== */

@media screen and (min-device-width: 768px) and (max-device-width: 1024px) and (-webkit-min-device-pixel-ratio: 1) {
  /* iPad 1, 2, Mini */
  .ipad-layout {
    --ipad-padding: 20px;
    --ipad-gap: 15px;
    --ipad-button-size: 60px;
    --ipad-font-large: 28px;
    --ipad-font-medium: 20px;
    --ipad-font-small: 16px;
  }
}

@media screen and (min-device-width: 768px) and (max-device-width: 1024px) and (-webkit-min-device-pixel-ratio: 2) {
  /* iPad 3, 4, Air, Air 2, Pro 9.7 */
  .ipad-layout {
    --ipad-padding: 25px;
    --ipad-gap: 18px;
    --ipad-button-size: 70px;
    --ipad-font-large: 32px;
    --ipad-font-medium: 22px;
    --ipad-font-small: 18px;
  }
}

@media screen and (min-device-width: 1024px) and (max-device-width: 1366px) and (-webkit-min-device-pixel-ratio: 2) {
  /* iPad Pro 10.5, 11, 12.9 */
  .ipad-layout {
    --ipad-padding: 30px;
    --ipad-gap: 20px;
    --ipad-button-size: 80px;
    --ipad-font-large: 36px;
    --ipad-font-medium: 24px;
    --ipad-font-small: 20px;
  }
}

/* ===== 基础iPad布局 ===== */

.ipad-layout {
  /* 确保内容适合单屏显示 */
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.ipad-layout .main-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  max-height: 100vh;
  margin: var(--ipad-padding);
  padding: var(--ipad-padding);
  border-radius: 25px;
  overflow: hidden;
}

/* ===== 头部区域 ===== */

.ipad-layout .main-header {
  flex-shrink: 0;
  margin-bottom: var(--ipad-gap);
}

.ipad-layout .main-title {
  font-size: var(--ipad-font-large);
  margin: 0 0 10px 0;
}

.ipad-layout .main-subtitle {
  font-size: var(--ipad-font-medium);
  margin: 0 0 15px 0;
}

/* ===== 等级信息区域 ===== */

.ipad-layout .current-level-info {
  flex-shrink: 0;
  margin: 15px 0;
  padding: 15px 20px;
  border-radius: 20px;
}

.ipad-layout .current-level-title {
  font-size: var(--ipad-font-medium);
  margin-bottom: 8px;
}

.ipad-layout .current-level-details {
  font-size: var(--ipad-font-small);
}

/* ===== 游戏模式选择 ===== */

.ipad-layout .game-modes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--ipad-gap);
  margin: var(--ipad-gap) 0;
  flex-shrink: 0;
  max-height: 50vh;
  overflow-y: auto;
  padding: 10px;
}

.ipad-layout .game-mode-card {
  padding: 25px;
  border-radius: 20px;
  min-height: 180px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  cursor: pointer;
  transition: all 0.3s ease;
  /* 增大点击区域 */
  touch-action: manipulation;
}

.ipad-layout .game-mode-card:hover,
.ipad-layout .game-mode-card:active {
  transform: translateY(-5px) scale(1.02);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
}

.ipad-layout .game-mode-icon {
  font-size: 64px;
  margin-bottom: 15px;
  align-self: center;
}

.ipad-layout .game-mode-title {
  font-size: var(--ipad-font-medium);
  margin: 0 0 10px 0;
  text-align: center;
}

.ipad-layout .game-mode-description {
  font-size: var(--ipad-font-small);
  line-height: 1.4;
  margin-bottom: 15px;
  text-align: center;
}

.ipad-layout .game-mode-features {
  font-size: 14px;
  text-align: center;
}

.ipad-layout .game-unlock-status {
  margin-top: 10px;
  justify-content: center;
  font-size: var(--ipad-font-small);
}

/* ===== 内容区域 ===== */

.ipad-layout .content-area {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 10px;
  /* 启用硬件加速滚动 */
  -webkit-overflow-scrolling: touch;
}

/* ===== 按钮样式 ===== */

.ipad-layout .cartoon-button,
.ipad-layout .back-button {
  min-height: var(--ipad-button-size);
  padding: 15px 30px;
  font-size: var(--ipad-font-small);
  border-radius: 30px;
  /* 增大点击区域 */
  touch-action: manipulation;
  margin: 10px;
}

.ipad-layout .cartoon-button:active {
  transform: scale(0.95);
}

/* ===== 气泡探索iPad优化 ===== */

.ipad-layout .bubble-words-container {
  height: 100%;
  width: 100%;
  overflow: hidden;
  padding: var(--ipad-padding);
  display: flex;
  flex-direction: column;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
}

.ipad-layout .progress-indicator {
  margin-bottom: var(--ipad-gap);
  padding: 15px;
  border-radius: 15px;
  flex-shrink: 0;
}

.ipad-layout .progress-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.ipad-layout .progress-stat-card {
  padding: 12px;
  border-radius: 12px;
  min-height: 70px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ipad-layout .progress-stat-icon {
  font-size: 26px;
  margin-bottom: 3px;
}

.ipad-layout .progress-stat-value {
  font-size: var(--ipad-font-medium);
  font-weight: 700;
}

.ipad-layout .progress-stat-label {
  font-size: 12px;
  text-align: center;
  line-height: 1.1;
}

/* ===== 气泡网格iPad优化 ===== */

.ipad-layout .words-grid-bubbles {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  /* 修改原因：实现左对齐布局，避免气泡分散显示（从 space-around 改为 flex-start） */
  justify-content: flex-start;
  align-items: flex-start;
  gap: 8px;
  padding: 5px;
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
  box-sizing: border-box;
}

.ipad-layout .bubble-word-card {
  width: 85px;
  height: 85px;
  min-width: 85px;
  min-height: 85px;
  font-size: 16px;
  /* 增大点击区域 */
  touch-action: manipulation;
  flex-shrink: 0;
}

.ipad-layout .bubble-word-card:active {
  transform: scale(0.95);
}

.ipad-layout .bubble-word-card.enlarged {
  transform: scale(2.2);
}

/* ===== 游戏界面iPad优化 ===== */

.ipad-layout .memory-game-container,
.ipad-layout .spelling-game-container,
.ipad-layout .word-catch-container,
.ipad-layout .word-speed-container {
  height: calc(100vh - 120px);
  max-height: none;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 记忆游戏 */
.ipad-layout .memory-cards {
  gap: 15px;
  padding: 20px;
}

.ipad-layout .memory-card {
  min-height: 80px;
  border-radius: 15px;
  font-size: var(--ipad-font-small);
}

/* 拼写游戏 */
.ipad-layout .spelling-input {
  font-size: var(--ipad-font-medium);
  padding: 15px;
  border-radius: 15px;
}

.ipad-layout .virtual-keyboard {
  gap: 10px;
}

.ipad-layout .keyboard-key {
  min-height: 50px;
  min-width: 50px;
  font-size: var(--ipad-font-small);
  border-radius: 12px;
}

/* 单词捕捉游戏 */
.ipad-layout .word-catch-game-area {
  height: 400px;
}

.ipad-layout .falling-word {
  font-size: var(--ipad-font-small);
  padding: 12px 18px;
  border-radius: 20px;
  min-width: 60px;
  text-align: center;
}

/* 单词竞速游戏 */
.ipad-layout .word-speed-choices {
  gap: 20px;
  padding: 20px;
}

.ipad-layout .word-speed-choice {
  min-height: 80px;
  font-size: var(--ipad-font-small);
  border-radius: 20px;
  padding: 20px;
}

/* ===== 通知和弹窗iPad优化 ===== */

.ipad-layout .achievement-notification {
  padding: 20px;
}

.ipad-layout .achievement-modal {
  max-width: 600px;
  padding: 40px;
  border-radius: 25px;
}

.ipad-layout .achievement-icon {
  font-size: 80px;
  margin-bottom: 20px;
}

.ipad-layout .achievement-modal h3 {
  font-size: var(--ipad-font-large);
  margin-bottom: 15px;
}

.ipad-layout .achievement-modal h4 {
  font-size: var(--ipad-font-medium);
  margin-bottom: 10px;
}

.ipad-layout .achievement-modal p {
  font-size: var(--ipad-font-small);
  margin: 10px 0;
}

.ipad-layout .achievement-close {
  min-height: var(--ipad-button-size);
  padding: 15px 30px;
  font-size: var(--ipad-font-small);
  border-radius: 30px;
}

/* ===== 滚动条样式 ===== */

.ipad-layout *::-webkit-scrollbar {
  width: 12px;
  height: 12px;
}

.ipad-layout *::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10px;
}

.ipad-layout *::-webkit-scrollbar-thumb {
  background: rgba(255, 107, 157, 0.6);
  border-radius: 10px;
  border: 2px solid transparent;
  background-clip: content-box;
}

.ipad-layout *::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 107, 157, 0.8);
  background-clip: content-box;
}

/* ===== 横屏优化 ===== */

@media screen and (orientation: landscape) and (max-height: 1024px) {
  .ipad-layout .main-container {
    flex-direction: row;
    align-items: flex-start;
  }
  
  .ipad-layout .main-header {
    flex: 0 0 300px;
    margin-right: var(--ipad-gap);
  }
  
  .ipad-layout .content-area {
    flex: 1;
    height: 100%;
  }
  
  .ipad-layout .game-modes {
    grid-template-columns: repeat(2, 1fr);
    max-height: none;
    height: 100%;
  }
}

/* ===== 性能优化 ===== */

.ipad-layout * {
  /* 启用硬件加速 */
  -webkit-transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  -webkit-perspective: 1000;
  
  /* 优化触摸响应 */
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  user-select: none;
}

.ipad-layout button,
.ipad-layout .game-mode-card,
.ipad-layout .bubble-word-card {
  /* 恢复可点击元素的选择 */
  -webkit-user-select: auto;
  user-select: auto;
}

/* ===== 动画性能优化 ===== */

.ipad-layout .animated {
  will-change: transform, opacity;
}

.ipad-layout .no-animation {
  animation: none !important;
  transition: none !important;
}

/* ===== 辅助功能 ===== */

.ipad-layout [role="button"],
.ipad-layout button,
.ipad-layout .clickable {
  min-height: 44px; /* iOS推荐的最小点击区域 */
  min-width: 44px;
}

/* ===== 调试辅助 ===== */

.ipad-debug .main-container {
  border: 2px solid red;
}

.ipad-debug .content-area {
  border: 2px solid blue;
}

.ipad-debug .game-modes {
  border: 2px solid green;
}