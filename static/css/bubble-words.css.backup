/* 
 * 气泡单词系统 - 有趣的互动学习体验
 * 隐藏单词类型，使用气泡图案增加趣味性
 */

/* ===== 气泡容器系统 ===== */

.bubble-words-container {
  position: relative;
  min-height: 100%;
  height: 100%;
  width: 100%;
  background: linear-gradient(135deg, 
    rgba(102, 126, 234, 0.1) 0%,
    rgba(118, 75, 162, 0.1) 50%,
    rgba(255, 107, 107, 0.1) 100%);
  border-radius: 20px;
  overflow: hidden;
  padding: 5px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 添加浮动的装饰气泡背景 */
.bubble-words-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    radial-gradient(circle at 20% 20%, rgba(255,107,107,0.15) 0%, transparent 60%),
    radial-gradient(circle at 80% 30%, rgba(78,205,196,0.15) 0%, transparent 60%),
    radial-gradient(circle at 40% 80%, rgba(255,230,109,0.15) 0%, transparent 60%),
    radial-gradient(circle at 70% 70%, rgba(147,112,219,0.12) 0%, transparent 50%),
    radial-gradient(circle at 10% 60%, rgba(255,20,147,0.1) 0%, transparent 55%);
  pointer-events: none;
  z-index: 1;
  transition: all 0.5s ease;
  animation: backgroundPulse 8s ease-in-out infinite;
}

@keyframes backgroundPulse {
  0%, 100% { opacity: 0.8; }
  50% { opacity: 1; }
}

/* 聚焦模式容器 */
.bubble-words-container.bubble-focused::before {
  background: rgba(0, 0, 0, 0.3);
}

.words-grid-bubbles {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  justify-content: space-around;
  align-items: flex-start;
  gap: 5px;
  padding: 3px;
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
  box-sizing: border-box;
}

/* ===== 气泡单词卡片 ===== */

.bubble-word-card {
  position: relative;
  width: 75px;
  height: 75px;
  min-width: 75px;
  min-height: 75px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b6b, #4ecdc4);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  overflow: hidden;
  flex-shrink: 0;
  
  /* 初始状态：显示装饰图案 */
  user-select: none;
  
  /* 随机动画延迟 */
  animation: bubbleFloat 4s ease-in-out infinite;
  animation-delay: var(--animation-delay, 0s);
}

/* 不同的气泡颜色主题 */
.bubble-word-card.theme-1 { background: linear-gradient(135deg, #ff9a9e, #fecfef); }
.bubble-word-card.theme-2 { background: linear-gradient(135deg, #a8edea, #fed6e3); }
.bubble-word-card.theme-3 { background: linear-gradient(135deg, #ffecd2, #fcb69f); }
.bubble-word-card.theme-4 { background: linear-gradient(135deg, #c2e9fb, #a1c4fd); }
.bubble-word-card.theme-5 { background: linear-gradient(135deg, #ffc3a0, #ffafbd); }
.bubble-word-card.theme-6 { background: linear-gradient(135deg, #667eea, #764ba2); }
.bubble-word-card.theme-7 { background: linear-gradient(135deg, #f093fb, #f5576c); }
.bubble-word-card.theme-8 { background: linear-gradient(135deg, #4facfe, #00f2fe); }

/* 气泡悬停效果 */
.bubble-word-card:hover {
  transform: scale(1.1) rotate(5deg);
  box-shadow: 0 8px 25px rgba(0,0,0,0.3);
  z-index: 10;
}

.bubble-word-card:active {
  transform: scale(0.95);
}

/* ===== 装饰图案层 ===== */

.bubble-decoration {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 32px;
  opacity: 0.8;
  transition: all 0.3s ease;
  pointer-events: none;
}

/* 随机装饰符号 - 更丰富的图案 */
.bubble-decoration.pattern-1::before { content: '🌟'; }
.bubble-decoration.pattern-2::before { content: '🎈'; }
.bubble-decoration.pattern-3::before { content: '💎'; }
.bubble-decoration.pattern-4::before { content: '🎨'; }
.bubble-decoration.pattern-5::before { content: '🌈'; }
.bubble-decoration.pattern-6::before { content: '🎭'; }
.bubble-decoration.pattern-7::before { content: '🎪'; }
.bubble-decoration.pattern-8::before { content: '🌺'; }
.bubble-decoration.pattern-9::before { content: '🦋'; }
.bubble-decoration.pattern-10::before { content: '🎵'; }
.bubble-decoration.pattern-11::before { content: '🏆'; }
.bubble-decoration.pattern-12::before { content: '🎯'; }
.bubble-decoration.pattern-13::before { content: '🌙'; }
.bubble-decoration.pattern-14::before { content: '⭐'; }
.bubble-decoration.pattern-15::before { content: '🎁'; }
.bubble-decoration.pattern-16::before { content: '🔮'; }
.bubble-decoration.pattern-17::before { content: '🌸'; }
.bubble-decoration.pattern-18::before { content: '🎊'; }
.bubble-decoration.pattern-19::before { content: '💫'; }
.bubble-decoration.pattern-20::before { content: '🌟'; }

/* ===== 单词显示层 ===== */

.bubble-word-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
  font-weight: 700;
  font-size: 16px;
  text-align: center;
  text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
  opacity: 0;
  transition: all 0.3s ease;
  max-width: 70px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}

/* 激活状态：显示单词，隐藏装饰 */
.bubble-word-card.revealed .bubble-decoration {
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.5);
}

.bubble-word-card.revealed .bubble-word-text {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* ===== 动画效果 ===== */

/* 浮动动画 */
@keyframes bubbleFloat {
  0%, 100% { 
    transform: translateY(0px) rotate(0deg); 
  }
  25% { 
    transform: translateY(-5px) rotate(1deg); 
  }
  50% { 
    transform: translateY(-8px) rotate(-1deg); 
  }
  75% { 
    transform: translateY(-3px) rotate(0.5deg); 
  }
}

/* 点击爆炸效果 */
.bubble-word-card.clicked {
  animation: bubbleExplode 0.6s ease-out;
}

@keyframes bubbleExplode {
  0% { 
    transform: scale(1); 
    filter: brightness(1);
  }
  50% { 
    transform: scale(1.3); 
    filter: brightness(1.5);
    box-shadow: 0 0 20px rgba(255,255,255,0.8);
  }
  100% { 
    transform: scale(1.1); 
    filter: brightness(1.2);
  }
}

/* 成功学习动画 */
.bubble-word-card.learned {
  background: linear-gradient(135deg, #56ab2f, #a8e6cf) !important;
  animation: learnedPulse 2s ease-in-out infinite;
}

@keyframes learnedPulse {
  0%, 100% { 
    transform: scale(1);
    box-shadow: 0 4px 15px rgba(86,171,47,0.3);
  }
  50% { 
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(86,171,47,0.5);
  }
}

/* ===== 响应式设计 ===== */

/* 小屏幕优化 */
@media (max-width: 480px) {
  .bubble-word-card {
    width: 60px;
    height: 60px;
    min-width: 60px;
    min-height: 60px;
  }
  
  .bubble-decoration {
    font-size: 28px;
  }
  
  .bubble-word-text {
    font-size: 14px;
    max-width: 60px;
  }
  
  .words-grid-bubbles {
    gap: 6px;
    padding: 5px;
  }
}

/* 中等屏幕 */
@media (min-width: 481px) and (max-width: 768px) {
  .bubble-word-card {
    width: 70px;
    height: 70px;
    min-width: 70px;
    min-height: 70px;
  }
  
  .words-grid-bubbles {
    gap: 8px;
    padding: 5px;
  }
}

/* 大屏幕 */
@media (min-width: 769px) {
  .bubble-word-card {
    width: 80px;
    height: 80px;
    min-width: 80px;
    min-height: 80px;
  }
  
  .bubble-decoration {
    font-size: 36px;
  }
  
  .bubble-word-text {
    font-size: 18px;
    max-width: 80px;
  }
  
  .words-grid-bubbles {
    gap: 10px;
    padding: 8px;
  }
}

/* ===== 特殊效果 ===== */

/* 鼠标跟随闪光效果 */
.bubble-word-card::after {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  border-radius: 50%;
  background: linear-gradient(45deg, 
    transparent, 
    rgba(255,255,255,0.2), 
    transparent, 
    rgba(255,255,255,0.2), 
    transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.bubble-word-card:hover::after {
  opacity: 1;
  animation: shimmer 1.5s ease-in-out infinite;
}

@keyframes shimmer {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 长单词特殊处理 */
.bubble-word-card .bubble-word-text.long-word {
  font-size: 12px;
  line-height: 1.1;
  white-space: normal;
  max-width: 65px;
  max-height: 40px;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

@media (min-width: 769px) {
  .bubble-word-card .bubble-word-text.long-word {
    font-size: 14px;
    max-width: 75px;
  }
}

/* ===== 可访问性支持 ===== */

/* 减少动画偏好 */
@media (prefers-reduced-motion: reduce) {
  .bubble-word-card {
    animation: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .bubble-word-card:hover {
    transform: scale(1.05);
  }
  
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* 高对比度模式 */
@media (prefers-contrast: more) {
  .bubble-word-card {
    border: 2px solid #000;
    background: #fff !important;
  }
  
  .bubble-word-text {
    color: #000 !important;
    text-shadow: none !important;
    font-weight: 900 !important;
  }
  
  .bubble-decoration {
    filter: grayscale(1) contrast(2);
  }
}

/* ===== 气泡聚焦效果 ===== */

/* 虚化的气泡 */
.bubble-word-card.blurred {
  opacity: 0.3;
  transform: scale(0.9);
  filter: blur(2px);
  transition: all 0.5s ease;
  pointer-events: none;
}

/* 聚焦的气泡 */
.bubble-word-card.focused {
  position: relative;
  z-index: 100;
  opacity: 1;
  filter: none;
  transition: all 0.5s ease;
}

/* 放大的气泡 */
.bubble-word-card.enlarged {
  transform: scale(1.8);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  animation: bubblePulse 2s ease-in-out infinite;
}

/* 聚焦时的脉动动画 */
@keyframes bubblePulse {
  0%, 100% { 
    transform: scale(1.8); 
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }
  50% { 
    transform: scale(1.9); 
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
  }
}

/* 聚焦模式下的网格调整 */
.bubble-words-container.bubble-focused .words-grid-bubbles {
  padding: 20px 10px;
  gap: 15px;
}

/* 移动设备上的聚焦效果优化 */
@media (max-width: 768px) {
  .bubble-word-card.enlarged {
    transform: scale(1.6);
  }
  
  .bubble-words-container.bubble-focused .words-grid-bubbles {
    padding: 15px 8px;
    gap: 12px;
  }
  
  @keyframes bubblePulse {
    0%, 100% { 
      transform: scale(1.6); 
    }
    50% { 
      transform: scale(1.7); 
    }
  }
}

/* 平板设备优化 */
@media (min-width: 769px) and (max-width: 1024px) {
  .bubble-word-card.enlarged {
    transform: scale(2.0);
  }
  
  @keyframes bubblePulse {
    0%, 100% { 
      transform: scale(2.0); 
    }
    50% { 
      transform: scale(2.1); 
    }
  }
}